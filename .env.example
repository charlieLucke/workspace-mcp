# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.
#
# Local (stdio) use needs NONE of the below — just `python -m workspace_mcp`.
# These are only for the public HTTP connector (see deploy/README.md).
# Transport/host/port/workspace-root are set by deploy/workspace-mcp.service;
# only the OAuth values belong here.

# WORKSPACE_MCP_AUTH=github
# WORKSPACE_MCP_BASE_URL=https://charliespc.taild04050.ts.net:8443
# WORKSPACE_GITHUB_CLIENT_ID=Ov23li...
# WORKSPACE_GITHUB_CLIENT_SECRET=...
# WORKSPACE_GITHUB_ALLOWED_LOGINS=charlieLucke
